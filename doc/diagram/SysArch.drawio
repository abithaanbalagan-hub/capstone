        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n    %% Users\n    A[Traveler]\n    B[Hotel Owner]\n    C[Admin]\n\n    %% Frontend\n    UI[Web Application / User Interface]\n\n    %% Backend\n    API[Spring Boot Backend]\n\n    %% Modules\n    UM[User Management]\n    HS[Smart Hotel Search]\n    HB[Hotel Booking]\n    BP[Budget Trip Planner]\n    BO[Smart Budget Optimization]\n    IG[Automatic Itinerary Generator]\n    TR[Tourist Place Recommendation]\n    RV[Review Management]\n    AD[Admin Management]\n\n    %% Database\n    DB[(MySQL Database)]\n\n    %% External / Supporting Services\n    PAY[Payment Module]\n\n    %% User to Frontend\n    A --&gt; UI\n    B --&gt; UI\n    C --&gt; UI\n\n    %% Frontend to Backend\n    UI --&gt; API\n\n    %% Backend to Modules\n    API --&gt; UM\n    API --&gt; HS\n    API --&gt; HB\n    API --&gt; BP\n    API --&gt; BO\n    API --&gt; IG\n    API --&gt; TR\n    API --&gt; RV\n    API --&gt; AD\n\n    %% Module Relationships\n    HS --&gt; HB\n    BP --&gt; BO\n    BP --&gt; IG\n    TR --&gt; IG\n    BO --&gt; HS\n    BO --&gt; TR\n\n    %% Database\n    UM --&gt; DB\n    HS --&gt; DB\n    HB --&gt; DB\n    BP --&gt; DB\n    BO --&gt; DB\n    IG --&gt; DB\n    TR --&gt; DB\n    RV --&gt; DB\n    AD --&gt; DB\n\n    %% Payment\n    HB --&gt; PAY\n    PAY --&gt; DB&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wBW3GS_uSL7Phtvn5X9a-1">
